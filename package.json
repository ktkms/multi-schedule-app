{
  "name": "multi-schedule-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "test": "jest --watch",
    "test:ci": "jest --ci --passWithNoTests",
    "test:unit": "jest",
    "test:e2e": "npx playwright test",
    "test:e2e:debug": "npx playwright test --headed --debug",
    "test:e2e:mobile": "npx playwright test --headed --project=\"Mobile Safari\"",
    "test:e2e:desktop": "npx playwright test --headed --project=chromium --project=firefox --project=webkit",
    "test:e2e:chrome": "npm run test:e2e:chrome:public && npm run test:e2e:auth",
    "test:e2e:chrome:public": "bash scripts/run-e2e-server.sh public",
    "test:e2e:auth": "bash scripts/run-e2e-server.sh auth",
    "test:e2e:chrome:headed": "npx playwright test --headed --project=chromium",
    "test:e2e:webkit": "npx playwright test --headed --project=webkit --project=\"Mobile Safari\"",
    "e2e:dev": "concurrently \"npm run dev\" \"npx playwright test --headed\"",
    "e2e": "npm run build && concurrently \"npm run start\" \"npx playwright test\"",
    "e2e:headless": "npm run build && npm run start & npx playwright test --reporter=dot",
    "e2e:ci": "npm run e2e:headless",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/uuid": "^10.0.0",
    "@vercel/og": "^0.6.8",
    "daisyui": "^5.7.50",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.23",
    "detect-inapp": "^1.4.0",
    "lucide-react": "^0.503.0",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "uuid": "^14.0.3",
    "web-haptics": "^0.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/detect-inapp": "^1.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__react": "^10.2.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "next": "^16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "undici": "^7.30.1",
    "wait-on": "^9.5.1",
    "web-streams-polyfill": "^4.3.0"
  },
  "overrides": {
    "tar": "7.5.13",
    "@auth/core": "0.41.3",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10 <11"
  }
}
